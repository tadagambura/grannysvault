{
  "expo": {
    "name": "Granny's Vault",
    "slug": "grannysvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "grannysvault",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kaoticchainz.grannysvault",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kaoticchainz.grannysvault",
      "adaptiveIcon": {
        "backgroundColor": "#8E2A44",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Granny's Vault",
      "themeColor": "#8E2A44",
      "backgroundColor": "#FBF6F1"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0E1310"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8E2A44"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Granny's Vault uses Face ID to keep your family's information locked."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
